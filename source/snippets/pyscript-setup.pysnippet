#BEGIN# import matplotlib
# Import matplotlib once at the beginning and make it available to all cells
try:
    import matplotlib
    import matplotlib.pyplot as plt
    
    # Set matplotlib to use Agg backend to prevent auto-display
    matplotlib.use('Agg')
    
    # Custom SDS style configuration
    custom_style = {
        # Axes settings
        'axes.axisbelow': True,
        'axes.facecolor': '#eaf3f5',
        'axes.edgecolor': 'black',
        'axes.linewidth': 1.0,
        'axes.grid': True,
        'axes.grid.axis': 'both',
        'axes.labelsize': 10,
        'axes.labelpad': 10,
        'axes.spines.top': False,
        'axes.spines.right': False,
        'axes.titlesize': 12,
        
        # Boxplots settings
        'boxplot.boxprops.color': 'C0',
        'boxplot.whiskerprops.color': 'C0',
        'boxplot.medianprops.linewidth': 2,
        'boxplot.medianprops.color': 'C1',
        
        # Figure settings
        'figure.dpi': 100,
        'figure.edgecolor': 'none',
        'figure.facecolor': '#eaf3f5',
        'figure.figsize': [4, 3.2],
        
        # Grid settings
        'grid.color': 'lightgray',
        'grid.linestyle': '-',
        'grid.linewidth': 0.5,
        'grid.alpha': 0.7,
        
        # Line settings (match sds.mplstyle; these had drifted from it)
        'lines.color': 'C4',
        'lines.linewidth': 1.0,
        'lines.markersize': 3,
        
        # Font settings
        'font.size': 12,
        'font.family': 'sans-serif',
        'axes.titlesize': 14,
        'axes.labelsize': 12,
        'xtick.labelsize': 10,
        'ytick.labelsize': 10,
        'legend.fontsize': 11,
        
        # Legend
        'legend.frameon': True,
        'legend.framealpha': 0.8,
        'legend.fancybox': True,
        'legend.shadow': False,
        
        # Mathtext settings
        'mathtext.fontset': 'stix',
        'mathtext.rm': 'stix',
        'mathtext.it': 'stix',
        
        # Patch settings
        'patch.facecolor': 'xkcd:baby blue',
        'patch.edgecolor': 'xkcd:blue gray',
        'patch.force_edgecolor': True,
        
        # Text settings
        'text.usetex': False,
        
        # Savefig settings
        'savefig.dpi': 100,
        'savefig.bbox': 'tight',
        'savefig.facecolor': '#eaf3f5',
        'savefig.edgecolor': 'none',
        
        # Ticks
        'xtick.direction': 'inout',
        'ytick.direction': 'inout',
        'xtick.major.size': 4,
        'ytick.major.size': 4,
        'xtick.minor.size': 2,
        'ytick.minor.size': 2
    }
    
    # Apply the custom style
    plt.rcParams.update(custom_style)

    # Match the static (notebook) figures: prepend_cell.py layers exactly these
    # overrides on top of sds.mplstyle, so applying them here gives interactive
    # (PyScript) figures the same dimensions, fonts and marker sizes.
    plt.rcParams.update({
        'figure.figsize': (3, 2),
        'figure.dpi': 150,
        'savefig.dpi': 150,
        'mathtext.fontset': 'cm',
        'font.size': 7,
        'axes.labelsize': 7,
        'axes.labelpad': 2,
        'axes.titlesize': 8,
        'xtick.labelsize': 6,
        'ytick.labelsize': 6,
        'legend.fontsize': 7,
    })
    console.log("Custom SDS matplotlib style applied successfully")

    # SDS axis labels: position the ylabel just above the top arrow and the
    # xlabel just past the right arrow (as prepend_cell.py does for the notebook
    # figures), so interactive figures can use plain set_xlabel/set_ylabel and
    # get the same placement. The axis _update_label_position hooks are patched
    # because matplotlib recomputes the label position at draw time; opt out of
    # a given label with loc='default'.
    from matplotlib.axes import Axes as _SdsAxes
    from matplotlib.axis import YAxis as _SdsYAxis, XAxis as _SdsXAxis

    _sds_orig_ylabel_update = _SdsYAxis._update_label_position
    def _sds_ylabel_update(self, renderer):
        if not getattr(self.axes, '_sds_ylabel_at_top', True):
            _sds_orig_ylabel_update(self, renderer)
        else:
            self.label.set_clip_on(False)
            self.label.set_transform(self.axes.transAxes)
            self.label.set_position((0.02, 1.06))
            self.label.set_ha('left')
            self.label.set_va('bottom')
    _SdsYAxis._update_label_position = _sds_ylabel_update

    _sds_orig_xlabel_update = _SdsXAxis._update_label_position
    def _sds_xlabel_update(self, renderer):
        if not getattr(self.axes, '_sds_xlabel_at_end', True):
            _sds_orig_xlabel_update(self, renderer)
        else:
            self.label.set_clip_on(False)
            self.label.set_transform(self.axes.transAxes)
            self.label.set_position((1.06, 0))
            self.label.set_ha('left')
            self.label.set_va('center')
    _SdsXAxis._update_label_position = _sds_xlabel_update

    _sds_orig_set_ylabel = _SdsAxes.set_ylabel
    def _sds_set_ylabel(self, ylabel, fontdict=None, labelpad=None, *, loc=None, **kwargs):
        if loc == 'default':
            self._sds_ylabel_at_top = False
            return _sds_orig_set_ylabel(self, ylabel, fontdict, labelpad, loc=None, **kwargs)
        self._sds_ylabel_at_top = True
        if labelpad is None:
            labelpad = 1
        kwargs.setdefault('rotation', 0)
        kwargs.setdefault('fontsize', plt.rcParams['axes.labelsize'] + 1)
        ha = kwargs.pop('ha', kwargs.pop('horizontalalignment', 'left'))
        va = kwargs.pop('va', kwargs.pop('verticalalignment', 'bottom'))
        result = _sds_orig_set_ylabel(self, ylabel, fontdict, labelpad, loc=loc, **kwargs)
        self.yaxis.label.set_ha(ha)
        self.yaxis.label.set_va(va)
        return result
    _SdsAxes.set_ylabel = _sds_set_ylabel

    _sds_orig_set_xlabel = _SdsAxes.set_xlabel
    def _sds_set_xlabel(self, xlabel, fontdict=None, labelpad=None, *, loc=None, **kwargs):
        if loc == 'default':
            self._sds_xlabel_at_end = False
            loc = 'center'
            ha = kwargs.pop('ha', kwargs.pop('horizontalalignment', 'center'))
            va = kwargs.pop('va', kwargs.pop('verticalalignment', 'top'))
        else:
            self._sds_xlabel_at_end = True
            if loc is None:
                loc = 'right'
            if labelpad is None:
                labelpad = 1
            kwargs.setdefault('fontsize', plt.rcParams['axes.labelsize'] + 1)
            ha = kwargs.pop('ha', kwargs.pop('horizontalalignment', 'left'))
            va = kwargs.pop('va', kwargs.pop('verticalalignment', 'center'))
        result = _sds_orig_set_xlabel(self, xlabel, fontdict, labelpad, loc=loc, **kwargs)
        self.xaxis.label.set_ha(ha)
        self.xaxis.label.set_va(va)
        return result
    _SdsAxes.set_xlabel = _sds_set_xlabel

    # SDS arrow-style axes: hide the bottom/left spines and draw axis arrows,
    # so interactive (pyscript) figures match the notebook ones produced via
    # prepend_cell.py. Figure.add_subplot is patched because plt.subplots()
    # routes through it.
    from matplotlib.axes import Axes as _SdsAxes
    from matplotlib.figure import Figure as _SdsFigure

    def _sds_setup_arrow_axes(ax):
        if getattr(ax, '_sds_arrows_added', False):
            return
        ax._sds_arrows_added = True
        c = plt.rcParams.get('axes.edgecolor', 'black')
        # Interactive figures render into a smaller pane than the notebook
        # figures, so nudge the arrow weight up a little so they don't look
        # thin (mutation_scale keeps the notebook's 8:1 head-to-line ratio).
        lw = plt.rcParams.get('axes.linewidth', 1.0) * 1.5
        kw = dict(xycoords='axes fraction', textcoords='axes fraction',
                  arrowprops=dict(arrowstyle='->', color=c, lw=lw,
                                  mutation_scale=12),
                  annotation_clip=False)
        ax.spines['bottom'].set_visible(False)
        ax.spines['left'].set_visible(False)
        ann_x = ax.annotate('', xy=(1.04, 0), xytext=(-0.02, 0), **kw)
        ann_y = ax.annotate('', xy=(0, 1.04), xytext=(0, -0.02), **kw)
        ax._sds_arrow_annots = [ann_x, ann_y]

    _sds_orig_axis_off = _SdsAxes.set_axis_off
    def _sds_set_axis_off(self, *a, **k):
        _sds_orig_axis_off(self, *a, **k)
        for ann in getattr(self, '_sds_arrow_annots', []):
            ann.set_visible(False)
    _SdsAxes.set_axis_off = _sds_set_axis_off

    _sds_orig_axis_on = _SdsAxes.set_axis_on
    def _sds_set_axis_on(self, *a, **k):
        _sds_orig_axis_on(self, *a, **k)
        for ann in getattr(self, '_sds_arrow_annots', []):
            ann.set_visible(True)
    _SdsAxes.set_axis_on = _sds_set_axis_on

    if not getattr(_SdsFigure, '_sds_patched', False):
        _SdsFigure._sds_patched = True
        _sds_orig_add_subplot = _SdsFigure.add_subplot
        def _sds_add_subplot(self, *a, **k):
            ax = _sds_orig_add_subplot(self, *a, **k)
            _sds_setup_arrow_axes(ax)
            return ax
        _SdsFigure.add_subplot = _sds_add_subplot

    _matplotlib_available = True
except ImportError:
    _matplotlib_available = False
    console.log("Matplotlib not available")
#END#

async def _ensure_localfs():
    """
    Recursively download everything under the `localfs` folder of the GitHub repo
    and replicate it under `/home/pyodide/localfs`.
    """

    manifest_url = "https://raw.githubusercontent.com/dariomalchiodi/sds/main/localfs/manifest.txt"

    try:
        # Download and read manifest file
        with open_url(manifest_url) as response:
            manifest_data = response.read()

        # Handle both bytes and string cases
        if isinstance(manifest_data, bytes):
            file_list = manifest_data.decode('utf-8').splitlines()
        else:
            file_list = manifest_data.splitlines()

        for relative_path in file_list:
            # Compute target path in Pyodide
            dst_path = os.path.join("/home/pyodide", relative_path)
            os.makedirs(os.path.dirname(dst_path), exist_ok=True)

            # Construct raw GitHub URL for the file
            file_url = f"https://raw.githubusercontent.com/dariomalchiodi/sds/main/localfs/{relative_path}"

            try:
                with open_url(file_url) as response:
                    file_data = response.read()

                # Ensure we always have bytes for writing
                if isinstance(file_data, str):
                    file_data = file_data.encode('utf-8')

                with open(dst_path, "wb") as f:
                    f.write(file_data)
            except Exception as e:
                console.log(f"Failed to fetch {relative_path}: {e}")

        # console.log("All localfs files downloaded successfully")
        return True

    except Exception as e:
        console.log(f"Error downloading localfs: {e}")
        return False

# Usage
await _ensure_localfs() 

# Utility function to hide splash loading indicators
def hide_splash(target_id):
    """Hide the splash loading div in the specified target element"""
    try:
        target_element = document.getElementById(target_id)
        if target_element:
            splash_divs = target_element.getElementsByClassName('splash')
            for splash in splash_divs:
                splash.style.display = 'none'
    except Exception as e:
        console.log(f"Could not hide splash in {target_id}: {e}")

console.log("PyScript utilities loaded successfully")